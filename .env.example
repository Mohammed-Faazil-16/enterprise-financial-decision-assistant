############################################
# APPLICATION
############################################
APP_NAME=enterprise-financial-decision-assistant
APP_ENV=local
APP_LOG_LEVEL=INFO

############################################
# BACKEND
############################################
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

############################################
# DATABASE (POSTGRES)
############################################
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=efda
POSTGRES_USER=efda_user
POSTGRES_PASSWORD=efda_password

############################################
# REDIS
############################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

############################################
# INFERENCE (ABSTRACTED)
############################################
INFERENCE_PROVIDER=ollama
INFERENCE_BASE_URL=http://ollama:11434
INFERENCE_MODEL=llama3.2-vision:11b-instruct-q4_K_M
INFERENCE_TIMEOUT_SECONDS=120

############################################
# RETRIEVAL / EMBEDDINGS
############################################
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=/app/data/faiss

############################################
# SECURITY & SAFETY
############################################
ENABLE_PII_DETECTION=true
ENABLE_PROMPT_INJECTION_GUARD=true
MAX_INPUT_TOKENS=4096

############################################
# MEMORY
############################################
SHORT_TERM_MEMORY_TTL_SECONDS=3600
LONG_TERM_MEMORY_ENABLED=true
SUMMARY_MEMORY_ENABLED=true

############################################
# EVALUATION / AUDIT
############################################
ENABLE_AUDIT_LOGS=true
AUDIT_LOG_PATH=/app/logs/audit.jsonl
